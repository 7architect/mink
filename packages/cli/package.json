{
  "name": "mink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node24 --platform node --dts --out-dir dist --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "bin": {
    "mink": "./dist/index.js"
  },
  "dependencies": {
    "@mink/core": "workspace:*",
    "@mink/tui": "workspace:*",
    "citty": "^0.2.2",
    "consola": "^3.4.2"
  }
}
